# Copy this file to .env and fill in the three keys.
# Never commit .env.

# Required
OPENAI_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

# OpenAI models
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# Pinecone
PINECONE_INDEX_NAME=cloudops-sentinel-openai-self-rag
PINECONE_NAMESPACE=incident-runbooks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Self-RAG loop limits
TOP_K=5
MAX_SUPPORT_RETRIES=2
MAX_RETRIEVAL_REWRITES=2
MAX_WEB_REWRITES=2

# Audit database (the LangGraph memory file is always data/langgraph_memory.sqlite)
DATABASE_PATH=data/audit.db
